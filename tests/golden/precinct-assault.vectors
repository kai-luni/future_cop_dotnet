# Shared single-player Precinct Assault front-end vectors.
# Checked by future-cop-lapd-ps1/tests/host/precinct_assault_test.sh (unchanged
# retail C units under qemu-mipsel, retail data image loaded from SLUS_007.39)
# and by FutureCop.Assets.Tests/PrecinctAssaultParityTests.cs.
# Line: name ops inputs... | expected...
#   ops: setupCW setupPA unlock select1p:A select2p:A initSetup join:A:ITEM
#        list:MSG find:LIST:VALUE loadoutInit clamp:MODE finalize:A:ITEM menu:ADDR
#   keys: see PrecinctAssaultParityTests (names mirror the harness field table);
#   recN_state = mission record N byte +0x1F, sess_XX = s32 at gGameSession+0xXX,
#   menu_XX = byte at the active menu descriptor +0xXX, push = last menu pushed.
# Each case starts from the retail boot image (BSS zero, menu 0x800A3808).

# gSetupPrecinctAssaultMissionList / gUpdatePrecinctUnlockFlag / gSetupCrimeWarMissionList
pa_setup_boot setupPA selectedMission=3 listMin=2 | selectedMission=0 listMin=0 listMax=3 listCount=4 listMode=1 listTable=0x8009B72C unlockFlag=0
pa_setup_unlocked setupPA unlockFlag=1 | listMax=4 listCount=5 listTable=0x8009B72C unlockFlag=1
pa_setup_cheat setupPA frontEndListFlag=1 | rec3_state=10 rec3_state2=10 rec7_state=10 rec10_state=10 rec15_state=10 rec6_state=10 rec6_state2=10 unlockFlag=1 listMax=4 listCount=5
unlock_all unlock rec3_state=10 rec7_state=10 rec10_state=10 rec15_state=10 | unlockFlag=1
unlock_one_short unlock rec3_state=10 rec7_state=10 rec10_state=10 rec15_state=9 unlockFlag=1 | unlockFlag=0
unlock_equal_not_ten unlock rec3_state=9 rec7_state=9 rec10_state=9 rec15_state=9 | unlockFlag=0
unlock_ignores_fifth unlock rec3_state=10 rec7_state=10 rec10_state=10 rec15_state=10 rec6_state=0 | unlockFlag=1
cw_setup_boot setupCW | selectedMission=0 listMin=0 listMax=0 listCount=8 listMode=0 listTable=0x8009B724 crimeWarProgress=0
cw_setup_cheat setupCW frontEndListFlag=1 | listMax=7 listCount=8 crimeWarProgress=8 savedCrimeWarProgress=8

