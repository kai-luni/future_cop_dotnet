<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FcModelViewer.Tizen</AssemblyName>
    <RootNamespace>FutureCop.Viewer.Tv</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Tizen assemblies are taken from the TV; scripts/fetch-tizen-refs.sh fills this dir. -->
    <TizenFrameworkDir Condition="'$(TizenFrameworkDir)' == ''">$(MSBuildThisFileDirectory)../../tizen/framework</TizenFrameworkDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Tizen.NUI">
      <HintPath>$(TizenFrameworkDir)/Tizen.NUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tizen.Applications.Common">
      <HintPath>$(TizenFrameworkDir)/Tizen.Applications.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tizen">
      <HintPath>$(TizenFrameworkDir)/Tizen.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tizen.Tracer">
      <HintPath>$(TizenFrameworkDir)/Tizen.Tracer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tizen.System">
      <HintPath>$(TizenFrameworkDir)/Tizen.System.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FutureCop.View/FutureCop.View.csproj" />
  </ItemGroup>
</Project>
